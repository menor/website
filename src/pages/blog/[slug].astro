---
import Post from "../../layouts/Post.astro";
import { findTwin, getAllPosts, postLang, postSlug } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts
    .filter((post) => postLang(post) === "en")
    .map((post) => ({
      params: { slug: postSlug(post) },
      props: { post, twin: findTwin(post, posts) },
    }));
}

const { post, twin } = Astro.props;
---

<Post post={post} twin={twin} />
